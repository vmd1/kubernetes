{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "dedupe": true,
    "gc": true,
    "gcDelay": "2h",
    "gcInterval": "24h",
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": ["**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            { "patterns": [".*"], "pulledWithin": "720h", "pushedWithin": "720h" }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "accessControl": {
      "repositories": {
        "**": { "anonymousPolicy": ["read"], "defaultPolicy": [] }
      }
    }
  },
  "log": { "level": "info" },
  "extensions": {
    "metrics": { "enable": true, "prometheus": { "path": "/metrics" } },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "1m",
          "content": [
            { "prefix": "**", "destination": "/" }
          ]
        }
      ]
    }
  }
}
